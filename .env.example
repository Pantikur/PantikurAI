API_KEY=your_api_key_here
PORT=8000

# === Переменные для токенов ===
# GIGACHAT_TOKEN=your_gigachat_token_here  # Для обогащения данных через GigaChat
# RETRAIN_TOKEN=your_retrain_token_here    # Для API-дообучения (/retrain)

# === Автономное обучение из книг ===
# Включить автообучение (true/false, по умолчанию: true)
AUTO_BOOK_LEARNING=true

# Длительность цикла в минутах (по умолчанию: 10)
AUTO_BOOK_LEARNING_CYCLE=10

# Максимум книг за цикл (по умолчанию: 5)
AUTO_BOOK_MAX_BOOKS=5

# Тем за цикл (по умолчанию: 2)
AUTO_BOOK_TOPICS=2

# === Rate limiting ===
# Запросов в минуту (по умолчанию: 30)
RATE_LIMIT_REQUESTS=30

# === Автопоиск слов в интернете ===
# Включить автопоиск (true/false, по умолчанию: true)
AUTO_WEB_SEARCH=true

# Интервал между циклами в секундах (по умолчанию: 3600 = 1 час)
AUTO_WEB_SEARCH_INTERVAL=3600

# Размер пакета слов за цикл (по умолчанию: 10)
AUTO_WEB_SEARCH_BATCH_SIZE=10

# Минимальная длина слова для извлечения (по умолчанию: 2 = включает предлоги/союзы)
AUTO_WEB_SEARCH_MIN_LENGTH=2

# Глубина извлечения слов из определений (1 = только из первых, 2 = и из найденных тоже)
AUTO_WEB_SEARCH_EXTRACT_DEPTH=1

# Максимум новых слов из одного определения (по умолчанию: 10)
AUTO_WEB_SEARCH_MAX_NEW_WORDS=10