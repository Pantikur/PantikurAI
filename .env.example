API_KEY=your_api_key_here
PORT=8000

# === Переменные для токенов ===
# GIGACHAT_TOKEN=your_gigachat_token_here  # Для обогащения данных через GigaChat
# RETRAIN_TOKEN=your_retrain_token_here    # Для API-дообучения (/retrain)

# === Автономное обучение из книг ===
# Включить автообучение (true/false, по умолчанию: true)
AUTO_BOOK_LEARNING=true

# Интервал между циклами в часах (по умолчанию: 1)
AUTO_BOOK_LEARNING_INTERVAL=1

# Максимум книг за цикл (по умолчанию: 3)
AUTO_BOOK_MAX_BOOKS=3

# Тем за цикл (по умолчанию: 2)
AUTO_BOOK_TOPICS=2