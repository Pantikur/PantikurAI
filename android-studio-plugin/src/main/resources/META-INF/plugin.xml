<?xml version="1.0" encoding="UTF-8"?>
<idea-plugin>
    <id>assistant.pantikur</id>
    <name>Pantikur AI Assistant</name>
    <vendor email="support@pantikur.dev" url="https://pantikur.dev">Pantikur AI</vendor>

    <description><![CDATA[
    <h1>🧠 AI Assistant — Профессиональный AI-помощник для Android-разработчиков</h1>

    <p>Полноценный AI-ассистент для Android Studio. Анализирует код локально (50+ правил),
    отвечает на вопросы из встроенной базы знаний, объясняет и исправляет код —
    <b>без RPG-ответов</b>, только профессиональный анализ.</p>

    <h2>🧠 Локальный интеллект (работает офлайн):</h2>
    <ul>
        <li><b>🔍 Code Review</b> — 50+ правил: null safety, lifecycle, утечки памяти, безопасность, производительность, Kotlin идиомы, deprecated API</li>
        <li><b>🔧 Auto Fix</b> — конкретный план исправления для каждой проблемы с решением</li>
        <li><b>📖 Quick Explain</b> — структура, метрики, ключевые элементы, замечания</li>
        <li><b>💬 Smart Chat</b> — база знаний по Kotlin, Android, архитектуре, крашам, корутинам, Room, Retrofit, Compose, Hilt и др.</li>
        <li><b>⚡ Анализ проекта</b> — полный скан всех файлов с отчётом по ошибкам</li>
        <li><b>🔄 Refactoring</b> — рекомендации по улучшению структуры кода</li>
        <li><b>📋 Метрики кода</b> — сложность, вложенность, длина методов, покрытие</li>
    </ul>

    <h2>🌐 Сетевые функции (через сервер):</h2>
    <ul>
        <li><b>⚡ Smart Insert</b> — генерация и вставка кода</li>
        <li><b>📱 App Generator</b> — генерация Android-приложений</li>
        <li><b>🎮 RPG/WorldEngine</b> — только для творческих запросов (отдельно от кода)</li>
    </ul>

    <h2>⌨️ Горячие клавиши:</h2>
    <ul>
        <li><b>Ctrl+Alt+R</b> — Code Review (локальный анализ)</li>
        <li><b>Ctrl+Alt+F</b> — Auto Fix (план исправления)</li>
        <li><b>Ctrl+Alt+E</b> — Quick Explain (объяснение кода)</li>
        <li><b>Ctrl+Alt+I</b> — Smart Insert (генерация кода)</li>
        <li><b>Ctrl+Alt+G</b> — Generate Code</li>
    </ul>

    <p><b>Принцип:</b> программистские вопросы обрабатываются локально — мгновенно и профессионально.
    RPG-движок используется только для творческих запросов и полностью отделён от анализа кода.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Боковая панель плагина -->
        <toolWindow id="Pantikur AI"
                    icon="/icons/plugin.svg"
                    anchor="right"
                    factoryClass="assistant.PantikurToolWindowFactory"/>
    </extensions>

    <actions>
        <!-- === PROFESSIONAL AI ACTIONS === -->
        
        <!-- Code Review -->
        <action id="assistant.CodeReview"
                class="assistant.actions.CodeReviewAction"
                text="🔍 Professional Code Review"
                description="Профессиональное код-ревью с детальным анализом">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt R"/>
        </action>

        <!-- Auto Fix -->
        <action id="assistant.AutoFix"
                class="assistant.actions.AutoFixAction"
                text="🔧 Auto Fix Errors"
                description="Автоматическое исправление ошибок">
            <add-to-group group-id="EditorPopupMenu" anchor="after"
                         relative-to-action="assistant.CodeReview"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt F"/>
        </action>

        <!-- Quick Explain -->
        <action id="assistant.QuickExplain"
                class="assistant.actions.QuickExplainAction"
                text="📖 Quick Explain"
                description="Быстрое объяснение выделенного кода">
            <add-to-group group-id="EditorPopupMenu" anchor="after"
                         relative-to-action="assistant.AutoFix"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt E"/>
        </action>

        <!-- Smart Insert -->
        <action id="assistant.SmartInsert"
                class="assistant.actions.SmartInsertAction"
                text="⚡ Smart Insert"
                description="Вставить AI-код в позицию курсора">
            <add-to-group group-id="EditorPopupMenu" anchor="after"
                         relative-to-action="assistant.QuickExplain"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt I"/>
        </action>

        <!-- === LEGACY ACTIONS === -->
        
        <!-- Генерация кода -->
        <action id="assistant.GenerateCode"
                class="assistant.actions.GenerateCodeAction"
                text="Generate Code with AI"
                description="Генерация Kotlin/Java кода с помощью AI">
            <add-to-group group-id="EditorPopupMenu" anchor="after"
                         relative-to-action="assistant.SmartInsert"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt G"/>
        </action>

        <!-- Анализ кода -->
        <action id="assistant.AnalyzeCode"
                class="assistant.actions.AnalyzeCodeAction"
                text="Analyze Code with AI"
                description="Анализ кода с помощью AI">
            <add-to-group group-id="EditorPopupMenu" anchor="after"
                         relative-to-action="assistant.GenerateCode"/>
        </action>

        <!-- Рефакторинг -->
        <action id="assistant.RefactorCode"
                class="assistant.actions.RefactorCodeAction"
                text="Refactor Code with AI"
                description="Рефакторинг кода с помощью AI">
            <add-to-group group-id="EditorPopupMenu" anchor="after"
                         relative-to-action="assistant.AnalyzeCode"/>
        </action>

        <!-- Объяснение кода -->
        <action id="assistant.ExplainCode"
                class="assistant.actions.ExplainCodeAction"
                text="Explain Code with AI"
                description="Объяснение кода с помощью AI">
            <add-to-group group-id="EditorPopupMenu" anchor="after"
                         relative-to-action="assistant.RefactorCode"/>
        </action>

        <!-- RPG Генератор -->
        <action id="assistant.RPGGenerator"
                class="assistant.actions.RPGGeneratorAction"
                text="RPG World Generator"
                description="Генерация RPG миров и персонажей">
            <add-to-group group-id="MainMenu" anchor="last"/>
        </action>

        <!-- WorldEngine -->
        <action id="assistant.WorldEngine"
                class="assistant.actions.WorldEngineAction"
                text="WorldEngine"
                description="Управление миром WorldEngine">
            <add-to-group group-id="MainMenu" anchor="after"
                         relative-to-action="assistant.RPGGenerator"/>
        </action>
    </actions>
</idea-plugin>
